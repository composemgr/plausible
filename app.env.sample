# Plausible Analytics — environment variable reference
# Copy relevant lines to a .env file alongside docker-compose.yaml

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# Application secret (min 64 chars recommended)
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=plausible
DB_USER_NAME=plausible
DB_USER_PASS=changeme_db_password

# Email / SMTP
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=noreply@example.com

# Registration control
# Set to "true" to prevent new signups
DISABLE_REGISTRATION=true
